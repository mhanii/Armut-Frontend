# Values Dokploy needs in the application's Environment tab (or a local
# `.env` next to docker-compose.yml when testing the stack with plain compose).

# Public https URLs, no trailing slash. These must be the domains you attach
# to the `web` and `api` services in Dokploy.
SITE_URL=https://armut.com
API_PUBLIC_URL=https://api.armut.com

# How the Next server reaches the API while rendering. docker-compose.yml sets
# this to http://api:4000 already; override only if you run the two services
# somewhere they cannot see each other over the compose network. Getting this
# wrong makes server-rendered product pages 404 for anything not in the
# bundled fixtures.
# API_INTERNAL_URL=http://api:4000

# Browser origins allowed to call the API — normally SITE_URL (add www if used).
CORS_ORIGIN=https://armut.com,https://www.armut.com

# Unique signing key, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Order email. Leave SMTP_HOST blank to deploy without sending.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Armut <no-reply@armut.com>
# Who gets the "new order" alert. Blank = every admin account in the database.
ADMIN_NOTIFY_EMAILS=orders@armut.com
STORE_NAME=Armut

# Optional: 'true' keeps the mock/live switch visible (staging only).
NEXT_PUBLIC_ENABLE_API_SWITCH=
