# Frontend build-time configuration (Next.js inlines NEXT_PUBLIC_* at build).
# Copy to .env.local for development; set these as build args/env in Dokploy.

# Base URL of the Armut API. Setting it switches the app to live data —
# leave blank to run on the built-in mock fixtures.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of the storefront itself (metadata, robots.txt, sitemap.xml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. 'live' or 'mock' to force the data source regardless of the URL above.
NEXT_PUBLIC_API_MODE=

# Optional. 'true' keeps the floating mock/live switch in a deployed build
# (useful on staging). Leave blank in production.
NEXT_PUBLIC_ENABLE_API_SWITCH=
