# Copy to .env and adjust. Everything below is read at boot.

# ---- runtime ---------------------------------------------------------------

# 'production' enables the safety checks (a real JWT_SECRET is then required).
NODE_ENV=development

# Port / interface the API listens on. In Docker keep HOST at 0.0.0.0.
PORT=4000
HOST=0.0.0.0

# Number of reverse proxies in front of the API (Dokploy/Traefik = 1).
TRUST_PROXY=1

# ---- security --------------------------------------------------------------

# Secret used to sign JWT access tokens. REQUIRED in production: at least 32
# characters and not the dev default, or the server refuses to start.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=armut-dev-secret-change-me

# Comma-separated list of allowed browser origins (the Next.js frontend).
# Use * to allow any origin (fine for local development only).
# Production example: https://armut.com,https://www.armut.com
CORS_ORIGIN=*

# ---- storage ---------------------------------------------------------------

# Where the SQLite file and uploaded images live (relative to backend/, or absolute).
# In Docker these are mounted volumes — see docker-compose.yml.
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Public base URL of THIS api, used to build absolute image URLs for uploads.
# Leave blank to derive it from the incoming request.
PUBLIC_URL=

# ---- email (order notifications) -------------------------------------------
# Leave SMTP_HOST blank to disable email: orders still succeed, nothing is sent.
# When set, every placed order emails the admins and confirms to the customer.

SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465). Leave blank to infer from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Envelope sender. Must be a domain your SMTP provider is allowed to send for.
MAIL_FROM=Armut <no-reply@example.com>

# Who receives the "new order" alert. Comma-separated.
# Leave blank to fall back to every admin account in the database.
ADMIN_NOTIFY_EMAILS=

# Branding used in email subjects/footers.
STORE_NAME=Armut
# Public storefront URL, no trailing slash. Password-reset links and the
# buttons in emails point here. In production a reset email is not sent
# without it (docker-compose.yml fills it from SITE_URL).
STORE_URL=
